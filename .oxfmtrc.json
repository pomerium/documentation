{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": true,
  "bracketSpacing": false,
  "importOrder": ["^@theme/.*", "^[./]"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "printWidth": 80,
  "proseWrap": "never",
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "src/pb",
    "build",
    "src/theme/index.ts",
    "dist",
    "node_modules",
    "build",
    "coverage",
    ".docusaurus",
    "packages/lqip-loader/lib/",
    "packages/docusaurus/lib/",
    "packages/docusaurus-*/lib/*",
    "packages/create-docusaurus/lib/*",
    "packages/create-docusaurus/templates/*/docusaurus.config.js",
    "packages/eslint-plugin/lib/",
    "packages/stylelint-copyright/lib/",
    "__fixtures__",
    "website/i18n",
    "website/versions.json",
    "website/docusaurus.config.js",
    "website/versioned_sidebars/*.json",
    "examples/",
    "website/static/katex/katex.min.css",
    "website/changelog/_swizzle_theme_tests",
    "website/_dogfooding/_swizzle_theme_tests",
    "content/docs/api/"
  ]
}
